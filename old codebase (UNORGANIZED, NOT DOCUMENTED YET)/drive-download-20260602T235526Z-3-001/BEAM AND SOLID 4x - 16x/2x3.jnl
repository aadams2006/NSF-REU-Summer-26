# -*- coding: mbcs -*-
from part import *
from material import *
from section import *
from assembly import *
from step import *
from interaction import *
from load import *
from mesh import *
from optimization import *
from job import *
from sketch import *
from visualization import *
from connectorBehavior import *
mdb.models['Model-1'].ConstrainedSketch(name='__profile__', sheetSize=200.0)
mdb.models['Model-1'].sketches['__profile__'].Line(point1=(-2.5, -2.5), point2=
    (2.5, 2.5))
mdb.models['Model-1'].sketches['__profile__'].Line(point1=(2.5, -2.5), point2=(
    -2.5, 2.5))
mdb.models['Model-1'].Part(dimensionality=TWO_D_PLANAR, name='beam lattice', 
    type=DEFORMABLE_BODY)
mdb.models['Model-1'].parts['beam lattice'].BaseWire(sketch=
    mdb.models['Model-1'].sketches['__profile__'])
del mdb.models['Model-1'].sketches['__profile__']
mdb.models['Model-1'].Material(name='trimethylolpropane triacrylate')
mdb.models['Model-1'].materials['trimethylolpropane triacrylate'].Elastic(
    table=((2000000000.0, 0.35), ))
mdb.models.changeKey(fromName='Model-1', toName='4x4 Beam')
mdb.Model(name='8x8 beam', objectToCopy=mdb.models['4x4 Beam'])
mdb.Model(name='16x16 beam', objectToCopy=mdb.models['8x8 beam'])
mdb.models['4x4 Beam'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['4x4 Beam'].rootAssembly.Instance(dependent=ON, name=
    'beam lattice-1', part=mdb.models['4x4 Beam'].parts['beam lattice'])
mdb.models['4x4 Beam'].rootAssembly.LinearInstancePattern(direction1=(1.0, 0.0, 
    0.0), direction2=(0.0, 1.0, 0.0), instanceList=('beam lattice-1', ), 
    number1=4, number2=4, spacing1=5.0, spacing2=5.0)
mdb.models['4x4 Beam'].rootAssembly.InstanceFromBooleanMerge(domain=GEOMETRY, 
    instances=(mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-1-2'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-1-3'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-1-4'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-2-1'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-2-2'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-2-3'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-2-4'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-3-1'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-3-2'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-3-3'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-3-4'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-4-1'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-4-2'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-4-3'], 
    mdb.models['4x4 Beam'].rootAssembly.instances['beam lattice-1-lin-4-4']), 
    name='lattice_4x4', originalInstances=SUPPRESS)
mdb.models['4x4 Beam'].StaticStep(initialInc=0.01, maxInc=0.01, name='loading', 
    previous='Initial')
mdb.models['4x4 Beam'].RectangularProfile(a=1.0, b=0.5, name='Profile-1')
mdb.models['4x4 Beam'].BeamSection(beamSectionOffset=(0.0, 0.0), 
    consistentMassMatrix=False, integration=DURING_ANALYSIS, material=
    'trimethylolpropane triacrylate', name='lattice', poissonRatio=0.0, 
    profile='Profile-1', temperatureVar=LINEAR)
mdb.models['4x4 Beam'].parts['lattice_4x4'].SectionAssignment(offset=0.0, 
    offsetField='', offsetType=MIDDLE_SURFACE, region=Region(
    edges=mdb.models['4x4 Beam'].parts['lattice_4x4'].edges.getSequenceFromMask(
    mask=('[#ffffffff:2 ]', ), )), sectionName='lattice', thicknessAssignment=
    FROM_SECTION)
mdb.models['4x4 Beam'].parts['lattice_4x4'].assignBeamSectionOrientation(
    method=N1_COSINES, n1=(0.0, 0.0, -1.0), region=Region(
    edges=mdb.models['4x4 Beam'].parts['lattice_4x4'].edges.getSequenceFromMask(
    mask=('[#ffffffff:2 ]', ), )))
mdb.models['4x4 Beam'].parts['lattice_4x4'].ReferencePoint(point=
    mdb.models['4x4 Beam'].parts['lattice_4x4'].vertices[21])
mdb.models['4x4 Beam'].rootAssembly.regenerate()
mdb.models['4x4 Beam'].rootAssembly.Set(name='ref_point', referencePoints=(
    mdb.models['4x4 Beam'].rootAssembly.instances['lattice_4x4-1'].referencePoints[4], 
    ))
mdb.models['4x4 Beam'].historyOutputRequests['H-Output-1'].setValues(rebar=
    EXCLUDE, region=mdb.models['4x4 Beam'].rootAssembly.sets['ref_point'], 
    sectionPoints=DEFAULT, variables=('U2', 'RF2'))
mdb.models['4x4 Beam'].EncastreBC(createStepName='Initial', localCsys=None, 
    name='hold', region=Region(
    vertices=mdb.models['4x4 Beam'].rootAssembly.instances['lattice_4x4-1'].vertices.getSequenceFromMask(
    mask=('[#80040000 #122 ]', ), )))
mdb.models['4x4 Beam'].Coupling(alpha=0.0, controlPoint=Region(
    referencePoints=(
    mdb.models['4x4 Beam'].rootAssembly.instances['lattice_4x4-1'].referencePoints[4], 
    )), couplingType=KINEMATIC, influenceRadius=WHOLE_SURFACE, localCsys=None, 
    name='Constraint-1', surface=Region(
    vertices=mdb.models['4x4 Beam'].rootAssembly.instances['lattice_4x4-1'].vertices.getSequenceFromMask(
    mask=('[#800004 #c0 ]', ), )), u1=ON, u2=ON, ur3=ON)
mdb.models['4x4 Beam'].DisplacementBC(amplitude=UNSET, createStepName='loading'
    , distributionType=UNIFORM, fieldName='', fixed=OFF, localCsys=None, name=
    'BC-2', region=Region(referencePoints=(
    mdb.models['4x4 Beam'].rootAssembly.instances['lattice_4x4-1'].referencePoints[4], 
    )), u1=UNSET, u2=2.0, ur3=UNSET)
mdb.models['4x4 Beam'].parts['lattice_4x4'].seedEdgeBySize(constraint=FINER, 
    deviationFactor=0.1, edges=
    mdb.models['4x4 Beam'].parts['lattice_4x4'].edges.getSequenceFromMask((
    '[#ffffffff:2 ]', ), ), size=0.1)
mdb.models['4x4 Beam'].parts['lattice_4x4'].seedPart(deviationFactor=0.1, 
    minSizeFactor=0.1, size=0.1)
mdb.models['4x4 Beam'].parts['lattice_4x4'].generateMesh()
mdb.models['4x4 Beam'].rootAssembly.regenerate()
mdb.Job(atTime=None, contactPrint=OFF, description='', echoPrint=OFF, 
    explicitPrecision=SINGLE, getMemoryFromAnalysis=True, historyPrint=OFF, 
    memory=90, memoryUnits=PERCENTAGE, model='4x4 Beam', modelPrint=OFF, 
    multiprocessingMode=DEFAULT, name='four_beam', nodalOutputPrecision=SINGLE, 
    numCpus=1, numGPUs=0, numThreadsPerMpiProcess=1, queue=None, resultsFormat=
    ODB, scratch='', type=ANALYSIS, userSubroutine='', waitHours=0, 
    waitMinutes=0)
mdb.jobs['four_beam'].submit(consistencyChecking=OFF)
mdb.jobs['four_beam']._Message(STARTED, {'phase': BATCHPRE_PHASE, 
